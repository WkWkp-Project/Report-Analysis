# Minimal production runtime
APP_ENV=production
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000

# Required secrets — generate unique values; never commit the real .env
APP_AUTH_PASSWORD=replace-with-at-least-12-characters
APP_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Facebook direct connector — fill these only after creating the Meta App
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_API_VERSION=v25.0
FB_REDIRECT_URI=http://localhost:8000/api/facebook/oauth/callback

# Optional AI enrichment
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Legacy manual-token adapter; leave blank for the OAuth connector
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
FB_AD_ACCOUNT_ID=
