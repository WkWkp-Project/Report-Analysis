# .env.example — copy เป็น .env และใส่ค่าจริง

# Page Access Token (long-lived)
# ได้จาก Graph API Explorer → Generate Token → เลือก page
# ต้อง permissions: pages_read_engagement, pages_read_user_content,
#                   read_insights, pages_show_list
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_token_here

# Page ID ของเพจที่ต้องการวิเคราะห์
FB_PAGE_ID=123456789012345

# (Optional) Ad Account ID สำหรับดึง ad performance
# format: act_XXXXXXXXXX
# ต้อง permissions: ads_read
FB_AD_ACCOUNT_ID=act_123456789012345
# (Optional) Claude API — เปิดใช้ topic extraction + narrative insight
# ถ้าไม่ใส่ ระบบจะ fallback เป็น deterministic insight (demo/live ยังทำงานได้)
ANTHROPIC_API_KEY=sk-ant-...
# (Optional) override โมเดล Claude ที่ใช้
ANTHROPIC_MODEL=claude-sonnet-4-6

# Production runtime
APP_DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:8000

# Facebook Login / direct connector (recommended)
# Add the exact FB_REDIRECT_URI to the Meta App's Valid OAuth Redirect URIs.
FB_APP_ID=your_meta_app_id
FB_APP_SECRET=your_meta_app_secret
FB_GRAPH_API_VERSION=v25.0
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
FB_REDIRECT_URI=http://localhost:8000/api/facebook/oauth/callback

# Use a long, stable random value in production. If omitted, FB_APP_SECRET is
# used as the encryption source so local setup remains simple.
TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret
